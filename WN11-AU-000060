# Requires: Administrator

Write-Host "Remediating WN11-AU-000060..." -ForegroundColor Cyan

# Enable "Audit: Force audit policy subcategory settings..."
$RegPath = "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa"
$ValueName = "SCENoApplyLegacyAuditPolicy"

if (-not (Test-Path $RegPath)) {
    New-Item -Path $RegPath -Force | Out-Null
}

New-ItemProperty -Path $RegPath `
    -Name $ValueName `
    -Value 1 `
    -PropertyType DWord `
    -Force | Out-Null

# Configure Audit Group Membership
auditpol.exe /set /subcategory:"Group Membership" /success:enable /failure:disable | Out-Null

# --------------------------
# Validation
# --------------------------

$Passed = $true

# Check registry value
